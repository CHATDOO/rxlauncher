<div id="overlayContainer" style="display: none;">
    <div id="serverSelectContent" style="display: none;">
        <span id="serverSelectHeader"><%- lang('overlay.serverSelectHeader') %></span>
        <div id="serverSelectList">
            <div id="serverSelectListScrollable">
                <!-- Server listings populated here. -->
            </div>
        </div>
        <div id="serverSelectActions">
            <button id="serverSelectConfirm" class="overlayKeybindEnter" type="submit"><%- lang('overlay.serverSelectConfirm') %></button>
            <div id="serverSelectCancelWrapper">
                <button id="serverSelectCancel" class="overlayKeybindEsc"><%- lang('overlay.serverSelectCancel') %></button>
            </div>
        </div>
    </div>
    <div id="serverCodeContent" style="display: none; padding: 28px; max-width: 460px; margin: 40px auto; background: rgba(18, 24, 38, 0.95); border: 1px solid rgba(255,255,255,0.12); border-top: 1px solid rgba(255,255,255,0.22); border-radius: 16px; box-shadow: 0 24px 60px rgba(0,0,0,0.85); backdrop-filter: blur(24px);">
        <span style="font-size: 1.25rem; font-weight: 700; color: #f8fafc; margin-bottom: 8px; display: block;">Code Serveur Pelican</span>
        <span style="font-size: 0.85rem; color: #94a3b8; margin-bottom: 18px; display: block; line-height: 1.5;">
            Entrez le code de votre serveur (ex: <code style="color: #38bdf8; font-weight: 700;">RX-8</code>, <code style="color: #38bdf8; font-weight: 700;">RX-9</code>, ou votre token de modpack).<br>
            <a href="#" id="openPelicanCodesLink" style="color: #60a5fa; text-decoration: underline; margin-top: 6px; display: inline-block;">Voir mes codes sur panel.rxcorp.me &rarr;</a>
        </span>
        <div style="margin-bottom: 20px;">
            <input id="serverCodeInput" type="text" placeholder="Ex: RX-8" style="width: 100%; padding: 12px 14px; background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.2); border-radius: 8px; color: #fff; font-size: 16px; font-family: monospace; outline: none; box-sizing: border-box;" />
            <div id="serverCodeFeedback" style="font-size: 13px; margin-top: 8px; display: none; font-weight: 500;"></div>
        </div>
        <div style="display: flex; gap: 10px; justify-content: flex-end;">
            <button id="serverCodeCancel" style="background: rgba(255,255,255,0.1); color: #fff; border: none; padding: 10px 18px; border-radius: 8px; font-size: 13px; font-weight: 500; cursor: pointer;">Annuler</button>
            <button id="serverCodeConfirm" style="background: linear-gradient(135deg, #2F5BEA, #1d4ed8); color: white; border: none; padding: 10px 22px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer;">Synchroniser</button>
        </div>
    </div>
    <div id="accountSelectContent" style="display: none;">
        <span id="accountSelectHeader"><%- lang('overlay.accountSelectHeader') %></span>
        <div id="accountSelectList">
            <div id="accountSelectListScrollable">
                <!-- Accounts populated here. -->
            </div>
        </div>
        <div id="accountSelectActions">
            <button id="accountSelectConfirm" class="overlayKeybindEnter" type="submit"><%- lang('overlay.accountSelectConfirm') %></button>
            <div id="accountSelectCancelWrapper">
                <button id="accountSelectCancel" class="overlayKeybindEsc"><%- lang('overlay.accountSelectCancel') %></button>
            </div>
        </div>
    </div>
    <div id="overlayContent">
        <span id="overlayTitle">Lorem Ipsum:<br>Finis Illud</span>
        <span id="overlayDesc">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud..</span>
        <div id="overlayActionContainer">
            <button id="overlayAcknowledge" class="overlayKeybindEnter">Conare Iterum</button>
            <div id="overlayDismissWrapper">
                <button id="overlayDismiss" style="display: none;" class="overlayKeybindEsc">Dismiss</button>
            </div>
        </div>
    </div>
    <script src="./assets/js/scripts/overlay.js"></script>
</div>